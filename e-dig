# --- PROGRAM CONFIGURATION ---
PROGRAM_NAME="${0##*/}"
VERSION="1.0.2"

# --- SYSTEM DEPENDENCY INSTALLER ---
install_deps() {
    echo "${PROGRAM_NAME}: verifying external software components..." >&2
    if ! command -v pipx >/dev/null 2>&1; then
        sudo apt update -qq && sudo apt install -y -qq pipx
        pipx ensurepath --quiet
    fi
    if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v mpv >/dev/null 2>&1; then
        sudo apt update -qq && sudo apt install -y -qq ffmpeg mpv
    fi
    if pipx list | grep -q "yt-dlp"; then
        pipx upgrade yt-dlp --quiet
    else
        pipx install "yt-dlp[default]" --quiet
    fi
    echo "${PROGRAM_NAME}: system requirements ready" >&2
}

# --- USAGE ---
usage() {
    cat <<EOF
Usage: ${PROGRAM_NAME} [OPTION]...

Extract high-quality audio samples with clean metadata from the web.

Mandatory arguments to long options are mandatory for short options too.
  -b, --batch=FILE       batch process a list of YouTube URLs from a text FILE
  -i, --initialize       install or update script requirements (yt-dlp, ffmpeg, mpv)
      --mpv              immediately play the audio stream after downloading
  -p, --path=DIR         specify a custom destination target download DIR
  -u, --url              trigger an interactive secure prompt to paste a single URL
  -v, --version          output upstream engine version information and exit
      --help             display this help and exit

Examples:
  ${PROGRAM_NAME} -u
  ${PROGRAM_NAME} -p ~/Samples -u
  ${PROGRAM_NAME} --mpv -u
  ${PROGRAM_NAME} -b links.txt

Report bugs to: <207926666+galaxy-cli@users.noreply.github.com>
EOF
}

# --- VERSION ---
show_version() {
    if ! command -v yt-dlp &>/dev/null; then
        echo "${PROGRAM_NAME} ${VERSION} (yt-dlp missing -- run with -i to install)"
    else
        local ytdl_ver
        ytdl_ver=$(yt-dlp --version 2>/dev/null)
        echo "${PROGRAM_NAME} ${VERSION} (yt-dlp engine version ${ytdl_ver})"
    fi
}

# --- INITIALIZE VARIABLES ---
save_path="."
play_now=false
download_urls=()
batch_file=""
do_initialize=false

# --- ARGUMENT PARSING ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help) 
            usage
            exit 0 
            ;;
        -v|--version) 
            show_version
            exit 0 
            ;;
        -p|--path) 
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'p'" >&2; exit 1; }
            save_path="$2" 
            shift 2 
            ;;
        --mpv) 
            play_now=true
            shift 
            ;;
        -i|--initialize) 
            do_initialize=true
            shift 
            ;;
        -u|--url)
            # Flag matching condition: handles URLs directly if pasted or delays to prompt
            if [[ -n "$2" && "$2" != -* ]]; then
                download_urls+=("$2")
                shift 2
            else
                echo -n "Paste YouTube URL and press Enter: "
                read -r pasted_url
                if [[ -n "${pasted_url//[:space:]/}" ]]; then
                    download_urls+=("$pasted_url")
                fi
                shift
            fi
            ;;
        -b|--batch)
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'b'" >&2; exit 1; }
            batch_file="$2"
            shift 2
            ;;
        -*)
            echo "${PROGRAM_NAME}: unrecognized option '$1'" >&2
            echo "Try '${PROGRAM_NAME} --help' for more information" >&2
            exit 1
            ;;
        *) 
            # Treat unflagged loose items as a fallback target URL safely
            download_urls+=("$1")
            shift
            ;;
    esac
done

# --- RUNTIME DEPENDENCY DEPLOYER ---
if [[ "$do_initialize" == true ]]; then
    install_deps
    exit 0
fi

# --- CRITICAL RUNTIME ENVIRONMENT VERIFICATION ---
if ! command -v yt-dlp >/dev/null 2>&1 || ! command -v ffmpeg >/dev/null 2>&1 || ! command -v mpv >/dev/null 2>&1; then
    echo "${PROGRAM_NAME}: missing core dependencies -- run '${PROGRAM_NAME} -i' first to configure" >&2
    exit 1
fi

# --- COMPONENT EXTRACTION & ENVIRONMENT VALIDATION ---
if [[ -n "$batch_file" ]]; then
    if [[ ! -e "$batch_file" ]]; then
        echo "${PROGRAM_NAME}: ${batch_file}: No such file or directory" >&2
        exit 1
    elif [[ ! -f "$batch_file" ]]; then
        echo "${PROGRAM_NAME}: ${batch_file}: Not a regular file" >&2
        exit 1
    elif [[ ! -r "$batch_file" ]]; then
        echo "${PROGRAM_NAME}: ${batch_file}: Permission denied" >&2
        exit 1
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip spatial markers and line return noises cleanly
        clean_line=$(echo "$line" | tr -d '\r' | xargs)
        [[ -n "$clean_line" && ! "$clean_line" =~ ^# ]] && download_urls+=("$clean_line")
    done < "$batch_file"
fi

if [[ ! -d "$save_path" ]]; then
    echo "${PROGRAM_NAME}: ${save_path}: No such directory" >&2
    exit 1
elif [[ ! -w "$save_path" ]]; then
    echo "${PROGRAM_NAME}: ${save_path}: Permission denied" >&2
    exit 1
fi

if (( ${#download_urls[@]} == 0 )); then
    echo "${PROGRAM_NAME}: no input target URLs specified" >&2
    echo "Try '${PROGRAM_NAME} --help' for more information" >&2
    exit 1
fi

# --- CORE DOWNLOADING ENGINE ---
# Set up interactive interrupt tracking arrays safely
cleanup() {
    pkill -P $$ yt-dlp ffmpeg mpv 2>/dev/null
}
trap 'cleanup; echo -e "\n[Session Interrupted]"; exit 1' SIGINT SIGTERM

for url in "${download_urls[@]}"; do
    # Remove tracking timestamp sub-variables safely
    clean_url="${url%%&*}"
    echo "${PROGRAM_NAME}: digging audio track elements..."
    
    filename_output=$(yt-dlp -x \
        -P "$save_path" \
        --audio-format wav \
        --audio-quality 0 \
        --no-warnings \
        --no-playlist \
        --output "%(title)s.%(ext)s" \
        --embed-metadata \
        --print "after_move:filepath" \
        "$clean_url" 2>/dev/null)

    if [[ $? -eq 0 && -n "$filename_output" ]]; then
        final_file=$(echo "$filename_output" | tail -n 1)
        echo "${PROGRAM_NAME}: success -- '$(basename "$final_file")' created"
        
        if [[ "$play_now" == true ]]; then
            echo "${PROGRAM_NAME}: auditioning sample container layout..."
            mpv --no-video "$final_file"
        fi
    else
        echo "${PROGRAM_NAME}: error -- download execution failed for target element URL" >&2
    fi
done

echo "--------------------------------"
echo "Session complete. Happy producing!"